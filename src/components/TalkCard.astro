---
import { Icon } from "astro-icon/components";

interface Props {
  title: string;
  description: string;
  tags: string[];
  href: string;
  langLabel: string;
}

const { title, description, tags, href, langLabel } = Astro.props;
---

<a
  href={href}
  class="group block bg-ivory dark:bg-dark-surface border border-border-cream dark:border-border-dark rounded-xl p-6 shadow-[rgba(0,0,0,0.05)_0px_4px_24px] hover:border-terracotta dark:hover:border-coral transition-colors"
>
  <article>
    <div class="flex items-start justify-between gap-4">
      <h3
        class="text-xl text-near-black dark:text-ivory group-hover:text-terracotta dark:group-hover:text-coral transition-colors"
        style="font-family: var(--font-serif);"
      >
        {title}
      </h3>
      <Icon
        name="fa6-solid:arrow-up-right-from-square"
        class="w-4 h-4 mt-1.5 shrink-0 text-olive-gray dark:text-warm-silver"
        aria-hidden="true"
      />
    </div>
    <p
      class="text-olive-gray dark:text-warm-silver mt-2 text-sm leading-relaxed"
    >
      {description}
    </p>
    <div class="flex flex-wrap gap-2 mt-4">
      <span
        class="text-xs font-medium text-ivory bg-terracotta px-2.5 py-1 rounded-lg"
      >
        {langLabel}
      </span>
      {
        tags.map((tag) => (
          <span class="text-xs font-medium text-charcoal-warm dark:text-warm-silver bg-warm-sand dark:bg-near-black px-2.5 py-1 rounded-lg">
            {tag}
          </span>
        ))
      }
    </div>
  </article>
</a>
